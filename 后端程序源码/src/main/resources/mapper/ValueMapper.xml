<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sipc.trash.mapper.ValueMapper">

    <delete id="deleteOldData">
        DELETE
        FROM value
        WHERE value.date NOT IN
              (SELECT sub.date
               FROM (SELECT date
                     FROM value
                     ORDER BY date DESC
                     LIMIT 100) as sub);
    </delete>
</mapper>